Description: Bedrock Access Gateway - OpenAI-compatible RESTful APIs for Amazon Bedrock (API Gateway + Lambda with Streaming)
Parameters:
  ApiKeySecretArn:
    Type: String
    # The full ARN, with the random suffix: the IAM policy below must match it exactly.
    AllowedPattern: ^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+-[A-Za-z0-9]{6}$
    Description: The full ARN (including the 6-character suffix) of the Secrets Manager secret that stores the API Key
  ContainerImageUri:
    Type: String
    Description: The ECR image URI for the Lambda function. Use a digest (repo@sha256:...) or a unique tag; an unchanged URI does not redeploy the function.
  DefaultModelId:
    Type: String
    Default: global.anthropic.claude-opus-5-5
    Description: The default model ID, please make sure the model ID is supported in the current region
  DefaultEmbeddingModelId:
    Type: String
    Default: amazon.titan-embed-text-v2:0
    Description: The embedding model used for OpenAI embedding model names (text-embedding-*), please make sure it is supported in the current region
  LogRetentionInDays:
    Type: Number
    Default: 90
    AllowedValues: [7, 14, 30, 60, 90, 180, 365, 731]
    Description: How long CloudWatch keeps the Lambda function logs
  EnableImageUrlFetch:
    Type: String
    Default: "true"
    AllowedValues:
      - "true"
      - "false"
    Description: Allow image_url content parts that point at remote http(s) URLs. When false, only base64 data URLs are accepted.
  ImageUrlAllowedHosts:
    Type: String
    Default: ""
    Description: Optional comma-separated list of hosts remote image URLs may point at. Empty allows any publicly routable host.
  EnablePromptCaching:
    Type: String
    Default: "false"
    AllowedValues:
      - "true"
      - "false"
    Description: Enable prompt caching for supported models (Claude, Nova). When enabled, adds cachePoint to system prompts and messages for cost savings.
  PromptCacheTtl:
    Type: String
    Default: "5m"
    AllowedValues:
      - "5m"
      - "1h"
    Description: How long a cache point keeps the prompt prefix. "1h" costs more to write (2x input instead of 1.25x) and pays off when conversations pause for more than five minutes. Applies to Claude 4.5 and later; other models keep the default.
  ThrottlingRateLimit:
    Type: Number
    Default: 10
    MinValue: 1
    Description: Steady-state requests per second the API accepts. Bounds the Bedrock spend if the API key leaks.
  ThrottlingBurstLimit:
    Type: Number
    Default: 20
    MinValue: 1
    Description: Requests the API accepts in a burst above the steady-state rate.
  AlarmEmail:
    Type: String
    Default: ""
    Description: Optional email for the alarms below (the address must confirm the SNS subscription). Empty creates no alarms.
  IdleHours:
    Type: Number
    Default: 24
    MinValue: 1
    MaxValue: 168
    Description: Alarm when the API has had no Lambda invocation for this many hours in a row (the client stopped calling, e.g. its host is down).
  SpikeInvocationsPerHour:
    Type: Number
    Default: 600
    MinValue: 1
    Description: Alarm when Lambda invocations in one hour exceed this (a leaked key or a runaway client).
  ServerErrorsPerHour:
    Type: Number
    Default: 10
    MinValue: 1
    Description: Alarm when the API returns more than this many 5XX responses in one hour.
  CostTagKey:
    Type: String
    Default: ""
    Description: Optional tag key on the Lambda role. Bedrock attributes each call to the calling IAM principal, so once activated as a cost allocation tag this tag separates the gateway's Bedrock cost in Cost Explorer. Empty sets no tag.
  CostTagValue:
    Type: String
    Default: ""
    Description: Value of the CostTagKey tag.
Conditions:
  HasAlarmEmail: !Not [!Equals [!Ref AlarmEmail, ""]]
  HasCostTag: !Not [!Equals [!Ref CostTagKey, ""]]
Resources:
  # IAM Role for Lambda
  ProxyApiHandlerServiceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: sts:AssumeRole
            Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
        Version: "2012-10-17"
      ManagedPolicyArns:
        - !Sub "arn:${AWS::Partition}:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
      Tags: !If
        - HasCostTag
        - - Key: !Ref CostTagKey
            Value: !Ref CostTagValue
        - !Ref AWS::NoValue

  ProxyApiHandlerServiceRoleDefaultPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyDocument:
        Statement:
          - Action:
              - bedrock:ListFoundationModels
              - bedrock:ListInferenceProfiles
            Effect: Allow
            Resource: "*"
          - Action:
              - bedrock:InvokeModel
              - bedrock:InvokeModelWithResponseStream
            Effect: Allow
            Resource:
              - !Sub "arn:${AWS::Partition}:bedrock:*::foundation-model/*"
              - !Sub "arn:${AWS::Partition}:bedrock:*:*:inference-profile/*"
              - !Sub "arn:${AWS::Partition}:bedrock:*:*:application-inference-profile/*"
          - Action:
              - secretsmanager:GetSecretValue
            Effect: Allow
            Resource: !Ref ApiKeySecretArn
        Version: "2012-10-17"
      PolicyName: ProxyApiHandlerServiceRoleDefaultPolicy
      Roles:
        - !Ref ProxyApiHandlerServiceRole

  ProxyApiHandlerLogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub "/aws/lambda/${AWS::StackName}-proxy-api"
      RetentionInDays: !Ref LogRetentionInDays

  # Lambda Function with Lambda Web Adapter for streaming
  ProxyApiHandler:
    Type: AWS::Lambda::Function
    Properties:
      Architectures:
        - arm64
      Code:
        ImageUri: !Ref ContainerImageUri
      Description: Bedrock Proxy API Handler with Response Streaming
      Environment:
        Variables:
          # Lambda Web Adapter settings
          AWS_LWA_INVOKE_MODE: RESPONSE_STREAM
          AWS_LWA_READINESS_CHECK_PATH: /health
          AWS_LWA_ASYNC_INIT: "true"
          PORT: "8080"
          # Application settings
          DEBUG: "false"
          API_KEY_SECRET_ARN: !Ref ApiKeySecretArn
          DEFAULT_MODEL: !Ref DefaultModelId
          DEFAULT_EMBEDDING_MODEL: !Ref DefaultEmbeddingModelId
          ENABLE_CROSS_REGION_INFERENCE: "true"
          ENABLE_APPLICATION_INFERENCE_PROFILES: "true"
          ENABLE_PROMPT_CACHING: !Ref EnablePromptCaching
          PROMPT_CACHE_TTL: !Ref PromptCacheTtl
          ENABLE_IMAGE_URL_FETCH: !Ref EnableImageUrlFetch
          IMAGE_URL_ALLOWED_HOSTS: !Ref ImageUrlAllowedHosts
          API_ROUTE_PREFIX: /v1
      LoggingConfig:
        LogFormat: Text
        LogGroup: !Ref ProxyApiHandlerLogGroup
      MemorySize: 1024
      PackageType: Image
      Role: !GetAtt ProxyApiHandlerServiceRole.Arn
      Timeout: 600
    DependsOn:
      - ProxyApiHandlerServiceRoleDefaultPolicy

  # API Gateway REST API (Regional)
  RestApi:
    Type: AWS::ApiGateway::RestApi
    Properties:
      Name: BedrockProxyApi
      Description: Bedrock Access Gateway - OpenAI-compatible API with streaming support
      EndpointConfiguration:
        Types:
          - REGIONAL
      Body:
        openapi: "3.0.1"
        info:
          title: BedrockProxyApi
          version: "1.0"
        paths:
          /{proxy+}:
            x-amazon-apigateway-any-method:
              parameters:
                - name: proxy
                  in: path
                  required: true
                  schema:
                    type: string
              x-amazon-apigateway-integration:
                type: aws_proxy
                httpMethod: POST
                uri: !Sub "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2021-11-15/functions/${ProxyApiHandler.Arn}/response-streaming-invocations"
                passthroughBehavior: when_no_match
                timeoutInMillis: 600000
                responseTransferMode: STREAM
              responses:
                default:
                  description: Default response
          /:
            x-amazon-apigateway-any-method:
              x-amazon-apigateway-integration:
                type: aws_proxy
                httpMethod: POST
                uri: !Sub "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2021-11-15/functions/${ProxyApiHandler.Arn}/response-streaming-invocations"
                passthroughBehavior: when_no_match
                timeoutInMillis: 600000
                responseTransferMode: STREAM
              responses:
                default:
                  description: Default response

  # Lambda Permission for API Gateway
  LambdaPermission:
    Type: AWS::Lambda::Permission
    Properties:
      FunctionName: !Ref ProxyApiHandler
      Action: lambda:InvokeFunction
      Principal: apigateway.amazonaws.com
      SourceArn: !Sub "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${RestApi}/*"

  # API Gateway Deployment. CloudFormation does not redeploy an unchanged Deployment,
  # so after editing the RestApi Body, rename this resource to publish the change.
  ApiDeployment:
    Type: AWS::ApiGateway::Deployment
    Properties:
      RestApiId: !Ref RestApi

  # API Gateway Stage
  ApiStage:
    Type: AWS::ApiGateway::Stage
    Properties:
      RestApiId: !Ref RestApi
      DeploymentId: !Ref ApiDeployment
      StageName: api
      Description: API Stage with streaming support
      MethodSettings:
        - ResourcePath: "/*"
          HttpMethod: "*"
          ThrottlingRateLimit: !Ref ThrottlingRateLimit
          ThrottlingBurstLimit: !Ref ThrottlingBurstLimit

  # Alarms, sent by email (and their recovery) when AlarmEmail is set.
  AlarmTopic:
    Type: AWS::SNS::Topic
    Condition: HasAlarmEmail
    Properties:
      Subscription:
        - Protocol: email
          Endpoint: !Ref AlarmEmail

  IdleAlarm:
    Type: AWS::CloudWatch::Alarm
    Condition: HasAlarmEmail
    Properties:
      AlarmDescription: !Sub "No call reached the gateway for ${IdleHours} hours: its client may be down."
      Namespace: AWS/Lambda
      MetricName: Invocations
      Dimensions:
        - Name: FunctionName
          Value: !Ref ProxyApiHandler
      Statistic: Sum
      Period: 3600
      EvaluationPeriods: !Ref IdleHours
      DatapointsToAlarm: !Ref IdleHours
      Threshold: 1
      ComparisonOperator: LessThanThreshold
      # An hour without invocations has no data point at all.
      TreatMissingData: breaching
      AlarmActions: [!Ref AlarmTopic]
      OKActions: [!Ref AlarmTopic]

  SpikeAlarm:
    Type: AWS::CloudWatch::Alarm
    Condition: HasAlarmEmail
    Properties:
      AlarmDescription: !Sub "More than ${SpikeInvocationsPerHour} gateway calls in an hour: a leaked key or a runaway client."
      Namespace: AWS/Lambda
      MetricName: Invocations
      Dimensions:
        - Name: FunctionName
          Value: !Ref ProxyApiHandler
      Statistic: Sum
      Period: 3600
      EvaluationPeriods: 1
      Threshold: !Ref SpikeInvocationsPerHour
      ComparisonOperator: GreaterThanThreshold
      TreatMissingData: notBreaching
      AlarmActions: [!Ref AlarmTopic]
      OKActions: [!Ref AlarmTopic]

  ServerErrorAlarm:
    Type: AWS::CloudWatch::Alarm
    Condition: HasAlarmEmail
    Properties:
      AlarmDescription: !Sub "More than ${ServerErrorsPerHour} 5XX responses from the gateway in an hour."
      Namespace: AWS/ApiGateway
      MetricName: 5XXError
      Dimensions:
        - Name: ApiName
          Value: BedrockProxyApi
        - Name: Stage
          Value: !Ref ApiStage
      Statistic: Sum
      Period: 3600
      EvaluationPeriods: 1
      Threshold: !Ref ServerErrorsPerHour
      ComparisonOperator: GreaterThanThreshold
      TreatMissingData: notBreaching
      AlarmActions: [!Ref AlarmTopic]
      OKActions: [!Ref AlarmTopic]

Outputs:
  APIBaseUrl:
    Description: Proxy API Base URL (OPENAI_API_BASE)
    Value: !Sub "https://${RestApi}.execute-api.${AWS::Region}.amazonaws.com/api/v1"
  RestApiId:
    Description: API Gateway REST API ID
    Value: !Ref RestApi
  LambdaFunctionArn:
    Description: Lambda Function ARN
    Value: !GetAtt ProxyApiHandler.Arn
